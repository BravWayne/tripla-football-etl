# ==============================================================================
# TRIPLA FOOTBALL ETL PIPELINE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Proxy Pool Configuration (Comma-separated HTTP/HTTPS proxy URLs for WAF bypass)
# Example: http://user:pass@ip:port,http://ip2:port2
TM_PROXIES=

# 2. Custom User-Agent & Contact Info (Wikidata / MyMemory API compliance)
CRAWLER_USER_AGENT="TriplaFootballCrawler/2.0 (https://github.com/BravWayne; contact@example.com) python-urllib"
MYMEMORY_CONTACT_EMAIL="contact@example.com"

# 3. Local LLM / OpenAI-Compatible Endpoint (Optional — used by clean_names.py fallback)
LLM_BASE_URL="http://127.0.0.1:11434/v1"
OPENAI_API_KEY="ollama"
LLM_MODEL="qwen2.5:7b"

# 4. Pipeline Target Output Files
STAGING_EXCEL_FILE="tripla_staging_raw.xlsx"
PRODUCTION_EXCEL_FILE="tripla-football-data.xlsx"
